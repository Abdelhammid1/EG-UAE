# Copy to .env and adjust. .env is git-ignored.
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Local dev uses SQLite automatically when DATABASE_URL is unset.
# Production (server): set DATABASE_URL to PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://marsoud:password@localhost:5432/marsoud

# Book currency (locked after first movement per spec §1.2). Do not change casually.
BOOK_CURRENCY=AED

# Optional external FX source (used later in Phase 1). Manual override always allowed.
FX_API_URL=
